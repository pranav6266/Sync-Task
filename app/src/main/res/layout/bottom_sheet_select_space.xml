<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingTop="16dp"
    android:paddingBottom="24dp"
    android:background="?attr/colorSurface">

    <View
        android:layout_width="32dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="?attr/colorOutlineVariant"
        android:layout_marginBottom="24dp"
        android:backgroundTint="?attr/colorOutlineVariant"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Actions"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="12dp"
        android:textAllCaps="true"
        android:letterSpacing="0.05"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textStyle="bold"
        android:textColor="?attr/colorOutline" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="24dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_action_create_space"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="New Space"
            app:icon="@drawable/ic_add"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_action_join_connect"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Join / Connect"
            app:icon="@drawable/ic_search_modern"/>
    </LinearLayout>

    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add Task To..."
        android:layout_marginStart="24dp"
        android:layout_marginBottom="12dp"
        android:textAllCaps="true"
        android:letterSpacing="0.05"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textStyle="bold"
        android:textColor="?attr/colorOutline" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_space_selection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"/>

</LinearLayout>